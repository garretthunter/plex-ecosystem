    {
      "name": "Is video bit rate < 5500 kbps",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const ffProbeData = args.inputFileObj.ffProbeData;\n  const streams = ffProbeData.streams;\n  const format = ffProbeData.format || {};\n  const CEILING_BPS = 5500000;\n\n  const parseDuration = (d) => {\n    if (!d) return null;\n    const parts = String(d).split(':');\n    if (parts.length !== 3) return null;\n    const [h, m, s] = parts;\n    const seconds = Number(h) * 3600 + Number(m) * 60 + parseFloat(s);\n    return Number.isFinite(seconds) ? seconds : null;\n  };\n\n  const video = streams.find((s) => s.codec_type === 'video');\n  const audios = streams.filter((s) => s.codec_type === 'audio');\n\n  let videoBitRate = null;\n\n  if (video) {\n    const directBitRate = Number(video.bit_rate);\n    if (Number.isFinite(directBitRate) && directBitRate > 0) {\n      videoBitRate = directBitRate;\n    } else {\n      // no per-stream bitrate reported - estimate from duration + total size minus audio\n      let duration = Number(video.duration);\n      if (!Number.isFinite(duration) || duration <= 0) {\n        duration = parseDuration(video.tags && video.tags.DURATION);\n      }\n      if (!Number.isFinite(duration) || duration <= 0) {\n        duration = Number(format.duration);\n      }\n\n      const size = Number(format.size);\n\n      if (Number.isFinite(duration) && duration > 0 && Number.isFinite(size) && size > 0) {\n        const totalBits = size * 8;\n        let audioBits = 0;\n        for (const a of audios) {\n          const abr = Number(a.bit_rate);\n          audioBits += (Number.isFinite(abr) && abr > 0 ? abr : 192000) * duration;\n        }\n        videoBitRate = (totalBits - audioBits) / duration;\n      }\n      // if duration or size is also missing, videoBitRate stays null - genuinely unknowable, assume compliant\n    }\n  }\n\n  const withinRange = videoBitRate === null || videoBitRate <= CEILING_BPS;\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: withinRange ? 1 : 2,\n    variables: args.variables,\n  };\n};\n"
      },
      "fpEnabled": true,
      "id": "FpSd1iSX9",
      "position": {
        "x": 612,
        "y": 1224
      }
    },
    {
      "name": "Handle multi track audio streams",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const streams = args.inputFileObj.ffProbeData.streams;\n  const CEILING_BPS = 680000;\n  let withinRange = true;\n\n  for (const stream of streams) {\n    if (stream.codec_type !== 'audio') continue;\n    const bitRate = Number(stream.bit_rate);\n    if (Number.isFinite(bitRate) && bitRate > 0 && bitRate > CEILING_BPS) {\n      withinRange = false;\n    }\n  }\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: withinRange ? 1 : 2,\n    variables: args.variables,\n  };\n};\n"
      },
