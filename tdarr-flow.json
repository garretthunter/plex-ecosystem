    {
      "name": "Fix stylized subtitles",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const { execFile } = require('child_process');\n  const fs = require('fs');\n  const os = require('os');\n  const path = require('path');\n  const util = require('util');\n  const execFileAsync = util.promisify(execFile);\n\n  const currentFile = args.inputFileObj._id;\n  const stamp = Date.now();\n  const rawSrtPath = path.join(os.tmpdir(), `subs_raw_${stamp}.srt`);\n  const strippedSrtPath = path.join(os.tmpdir(), `subs_stripped_${stamp}.srt`);\n\n  const origExt = path.extname(currentFile);\n  const origBase = path.basename(currentFile, origExt);\n  const remuxedPath = path.join(os.tmpdir(), `${origBase}${origExt}`);\n\n  const { stdout: probeOut } = await execFileAsync('ffprobe', [\n    '-v', 'error',\n    '-select_streams', 's',\n    '-show_entries', 'stream=index,codec_name:stream_tags=language',\n    '-of', 'json',\n    currentFile,\n  ]);\n  const probeData = JSON.parse(probeOut);\n  const subStream = (probeData.streams || []).find((s) => s.codec_name === 'subrip');\n\n  if (!subStream) {\n    return { outputFileObj: args.inputFileObj, outputNumber: 1, variables: args.variables };\n  }\n\n  const language = (subStream.tags && subStream.tags.language) || 'eng';\n\n  // pull the styled SRT out as plain text\n  await execFileAsync('ffmpeg', [\n    '-y', '-i', currentFile,\n    '-map', `0:${subStream.index}`,\n    '-c:s', 'copy',\n    rawSrtPath,\n  ]);\n\n  // strip every inline tag, keep the text\n  const rawText = fs.readFileSync(rawSrtPath, 'utf8');\n  const strippedText = rawText.replace(/<[^>]+>/g, '');\n  fs.writeFileSync(strippedSrtPath, strippedText);\n\n  // remux: everything from the current file except its subtitle and any font\n  // attachments (they existed to render the original styled ASS track; plain SRT\n  // doesn't reference fonts, so they're dead weight once we're in this function),\n  // plus the stripped subtitle\n  await execFileAsync('ffmpeg', [\n    '-y',\n    '-i', currentFile,\n    '-i', strippedSrtPath,\n    '-map', '0:v',\n    '-map', '0:a',\n    '-map', '1:0',\n    '-c', 'copy',\n    '-c:s', 'copy',\n    '-metadata:s:0', `language=${language}`,\n    '-disposition:s:0', 'default',\n    remuxedPath,\n  ]);\n\n  fs.unlinkSync(rawSrtPath);\n  fs.unlinkSync(strippedSrtPath);\n\n  return {\n    outputFileObj: { _id: remuxedPath },\n    outputNumber: 1,\n    variables: args.variables,\n  };\n};\n"
      },
