    {
      "name": "Fix 10-bit H264 QSV decode",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const streams = args.variables.ffmpegCommand.streams;\n  for (const s of streams) {\n    if (\n      s.codec_type === 'video'\n      && s.codec_name === 'h264'\n      && String(s.bits_per_raw_sample) === '10'\n      && s.outputArgs.includes('h264_qsv')\n    ) {\n      // QSV hardware decode does not support H264 High10 (10-bit) on this\n      // iGPU (\"Error submitting packet to decoder: Function not implemented\").\n      // Force software decode for this stream, then convert to 8-bit NV12 in\n      // software before the QSV encoder, which also requires 8-bit input.\n      s.inputArgs = s.inputArgs.filter(\n        (a) => a !== '-hwaccel' && a !== 'qsv' && a !== '-hwaccel_output_format',\n      );\n      s.outputArgs.push('-vf', 'format=nv12');\n    }\n  }\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: 1,\n    variables: args.variables,\n  };\n};\n"
      },
      "fpEnabled": true,
      "id": "LiC2IhdZs",
      "position": {
        "x": 684,
        "y": 1776
      }
    },
    {
      "name": "Strip extra PGS/VobSub subtitles",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "inputsDB": {
        "code": "module.exports = async (args) => {\n  const { execFile } = require('child_process');\n  const util = require('util');\n  const execFileAsync = util.promisify(execFile);\n\n  const streams = args.variables.ffmpegCommand.streams;\n  const imageSubCodecs = ['hdmv_pgs_subtitle', 'dvd_subtitle', 'dvb_subtitle'];\n  const imageSubs = streams.filter(\n    (s) => s.codec_type === 'subtitle' && imageSubCodecs.includes(s.codec_name)\n  );\n\n  if (imageSubs.length > 1) {\n    const { stdout } = await execFileAsync('ffprobe', [\n      '-v', 'error',\n      '-select_streams', 's',\n      '-show_entries', 'stream=index,codec_name:stream_tags=language',\n      '-of', 'json',\n      args.inputFileObj._id,\n    ]);\n    const probeStreams = JSON.parse(stdout).streams || [];\n    const langByIndex = {};\n    for (const ps of probeStreams) {\n      langByIndex[ps.index] = (ps.tags && ps.tags.language) || '';\n    }\n\n    const keep = imageSubs.find((s) => langByIndex[s.index] === 'eng') || imageSubs[0];\n    for (const s of imageSubs) {\n      if (s !== keep) {\n        s.removed = true;\n      }\n    }\n    args.variables.needsTranscode = '1';\n  }\n\n  return {\n    outputFileObj: args.inputFileObj,\n    outputNumber: 1,\n    variables: args.variables,\n  };\n};\n"
      },
      "fpEnabled": true,
      "id": "PGSbLm3xQ",
      "position": {
        "x": 768,
        "y": -300
      }
    }
  ],
