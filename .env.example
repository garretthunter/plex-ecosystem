##
# Base environment variables for the Docker containers
# Copy this file to .env and fill in the values
##
HOST_MOUNT=/your/mount/point  # Absolute path to the media drive mount point
LOCAL_MOUNT=/your/local/path  # Absolute path to local storage for Plex/Tdarr config+database
HOSTNAME=your-hostname        # Used by Notifiarr

# Secrets
NOTIFIARR_API_KEY=your-notifiarr-api-key
APPRISE_KEY=your-apprise-notify-key    # used by update.sh for Discord notifications
TDARR_API_KEY=tapi_your-generated-key-here  # min 14 chars incl. "tapi_" prefix; used by Tdarr's internal node to auth to its own server
CLOUDFLARE_API_KEY=your-cloudflare-api-token  # Zone:DNS:Edit scoped to blacktower.com; used by cloudflare-ddns
